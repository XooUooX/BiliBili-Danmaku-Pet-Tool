# 服务配置
PORT=3000
# 请替换为至少 32 字符的随机字符串，切勿使用示例值部署到公网。
SESSION_SECRET=replace-with-a-long-random-string
# 对外访问地址；支付与第三方登录回调依赖此地址。
SITE_URL=http://localhost:3000
# 多实例部署时只能在一个实例启用自动调度。
SCHEDULER_ENABLED=true

# MySQL 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# 首次执行 npm run init-db 时创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# 易支付（也可在管理后台保存，数据库配置优先）
EPAY_ENABLED=false
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=

# 支付宝官方接口（也可在管理后台保存，数据库配置优先）
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=

# 聚合第三方登录（也可在管理后台保存，数据库配置优先）
OAUTH_ENABLED=false
OAUTH_API_URL=
OAUTH_APPID=
OAUTH_APPKEY=
# 可选：qq,wx,alipay,sina,baidu,douyin,huawei,xiaomi,google,microsoft,twitter,dingtalk,gitee,github
OAUTH_PROVIDERS=qq,wx
